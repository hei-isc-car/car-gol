{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "command": "cargo build",
            "type": "shell",
        },
        {
            "label": "golrs-debug-build",
            "type": "shell",
            "command": "just gol-debug-build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}
